# Configuration backend (développement local) — copier vers backend/.env
# Générer les secrets : ./scripts/generate-secrets.sh
# Le serveur refuse de démarrer si un secret est absent ou trop faible.

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/financepilot

# Deux secrets différents, ≥ 32 caractères : openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_SECRET=

# Exactement 64 caractères hexadécimaux : openssl rand -hex 32
# ⚠️ Ne jamais changer cette clé une fois des données enregistrées (elles deviendraient illisibles).
ENCRYPTION_KEY=

# Origine(s) autorisée(s) en CORS, séparées par des virgules (localhost:3000-3002 autorisés d'office en dev)
FRONTEND_URL=http://localhost:3000

# Optionnel
# LOG_LEVEL=debug
