# Configuration backend (production hors Docker) — voir aussi .env.docker.example
NODE_ENV=production
PORT=5000
# Origine publique exacte de l'application (CORS)
FRONTEND_URL=https://votre-domaine.com

# MongoDB : utiliser un compte à droits restreints (readWrite sur la base)
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster.mongodb.net/financepilot?retryWrites=true&w=majority

# openssl rand -hex 64 (deux valeurs différentes)
JWT_SECRET=
JWT_REFRESH_SECRET=
# openssl rand -hex 32 — ne jamais changer après mise en service
ENCRYPTION_KEY=

# Nombre de reverse proxies devant le backend (nginx = 1)
TRUST_PROXY=1
# Rediriger HTTP → HTTPS (si le proxy transmet X-Forwarded-Proto)
FORCE_HTTPS=true
# Cookie de session "Secure" (défaut : true en production)
COOKIE_SECURE=true

LOG_LEVEL=info
