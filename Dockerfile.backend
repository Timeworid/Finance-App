# Dockerfile du backend FinancePilot
# Node 22 LTS (Node 18 n'est plus maintenu depuis avril 2025)
FROM node:22-alpine AS builder

# bcrypt 6 fournit des binaires précompilés musl (x64/arm64) : aucun outil de compilation requis
WORKDIR /app

# Dépendances d'abord (cache Docker) ; npm ci exige le package-lock.json versionné
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY backend/ ./
RUN mkdir -p logs

# --- Image de production ---
FROM node:22-alpine

LABEL description="Backend API for FinancePilot - Secure Personal Finance Management"

WORKDIR /app

# L'image node fournit déjà l'utilisateur non-root "node"
COPY --from=builder --chown=node:node /app ./

ENV NODE_ENV=production
EXPOSE 5000
USER node

HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://localhost:5000/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

# server.js gère SIGTERM/SIGINT (arrêt propre) ; docker-compose ajoute un init (init: true)
CMD ["node", "server.js"]
