# Variables d'environnement pour Docker Compose
# 1. cp .env.docker.example .env.docker
# 2. Générer les secrets : ./scripts/generate-secrets.sh  (ou les commandes ci-dessous)
# 3. docker compose --env-file .env.docker up -d --build
#
# Tous les secrets sont OBLIGATOIRES : le démarrage échoue s'ils sont absents
# ou trop faibles (moins de 32 caractères).

# ---------- MongoDB ----------
MONGO_ROOT_USER=admin
# openssl rand -hex 24
MONGO_ROOT_PASSWORD=
# Compte utilisé par le backend (droits restreints) — openssl rand -hex 24
MONGO_APP_PASSWORD=

# ---------- JWT (deux secrets différents) ----------
# openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---------- Chiffrement AES-256-GCM ----------
# openssl rand -hex 32  (exactement 64 caractères hexadécimaux)
# ⚠️ Ne JAMAIS changer cette clé après mise en service : les données deviendraient illisibles.
ENCRYPTION_KEY=

# ---------- Réseau ----------
# Origine publique de l'application, telle qu'affichée dans le navigateur
FRONTEND_URL=http://localhost
# Port publié par nginx sur l'hôte
HTTP_PORT=80
# true uniquement si un proxy TLS en amont fournit HTTPS
FORCE_HTTPS=false
# Cookie de session "Secure" (fonctionne aussi sur http://localhost). Mettre false
# uniquement pour un accès HTTP via une IP ou un nom de domaine sans TLS.
COOKIE_SECURE=true

# ---------- Logs ----------
LOG_LEVEL=info
